{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { 
        "maxLambdaSize": "50mb",
        "maxDuration": 60
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/(.*)",     "dest": "frontend/$1" }
  ],
  "env": {
    "SCAN_TIMEOUT": "55",
    "ALLOWED_ORIGINS": "https://code-shield-gamma.vercel.app,http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000",
    "GIT_PYTHON_REFRESH": "quiet"
  }
}
